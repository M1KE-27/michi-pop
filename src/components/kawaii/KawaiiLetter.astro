---
interface Props {
  char: string;
  color: 'rosa' | 'amarillo' | 'lila' | 'menta' | 'naranja' | 'lima' | 'azul';
  rotate?: number;
  scale?: number;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  interactive?: boolean;
}

const { char, color, rotate = 0, scale = 1, size = 'lg', interactive = true } = Astro.props;

const gradients = {
  rosa: 'linear-gradient(150deg, #F9B0BF 5%, #F489A0 62%, #D96F89 100%)',
  amarillo: 'linear-gradient(150deg, #FFE58C 5%, #FED45D 62%, #D7B13B 100%)',
  lila: 'linear-gradient(150deg, #CAB4E0 5%, #B495D5 62%, #9272B7 100%)',
  menta: 'linear-gradient(150deg, #A6DECB 5%, #7ECBB2 62%, #5AA18B 100%)',
  naranja: 'linear-gradient(150deg, #FFB57C 5%, #F98F3E 62%, #D16C27 100%)',
  lima: 'linear-gradient(150deg, #D1E993 5%, #AED657 62%, #8CA83A 100%)',
  azul: 'linear-gradient(150deg, #B3DBED 5%, #8DC4E3 62%, #679EBE 100%)',
} as const;

const shadows = {
  rosa: '0 .24em 0 #D56F89, 0 .52em .85em rgba(48,44,43,.17)',
  amarillo: '0 .24em 0 #D8AF3E, 0 .52em .85em rgba(48,44,43,.17)',
  lila: '0 .24em 0 #8E72B6, 0 .52em .85em rgba(48,44,43,.17)',
  menta: '0 .24em 0 #5A9F89, 0 .52em .85em rgba(48,44,43,.17)',
  naranja: '0 .24em 0 #CE6A23, 0 .52em .85em rgba(48,44,43,.17)',
  lima: '0 .24em 0 #8CA439, 0 .52em .85em rgba(48,44,43,.17)',
  azul: '0 .24em 0 #659DBD, 0 .52em .85em rgba(48,44,43,.17)',
} as const;

const fontSize = {
  sm: 'clamp(2.3rem, 9vw, 4rem)',
  md: 'clamp(3rem, 8vw, 5.5rem)',
  lg: 'clamp(4rem, 11vw, 9rem)',
  xl: 'clamp(5rem, 15vw, 13rem)',
}[size];
---
<span
  class={`kawaii-letter display-font ${interactive ? 'kawaii-interactive' : ''}`}
  data-kawaii-interactive={interactive ? 'true' : undefined}
  style={`--letter-gradient:${gradients[color]};--letter-shadow:${shadows[color]};--rotate:${rotate}deg;--scale:${scale};font-size:${fontSize};`}
  aria-hidden="true"
>{char}</span>
