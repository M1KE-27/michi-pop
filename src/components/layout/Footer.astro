---
import { siteUrl } from '../../lib/site';
---

<footer class="border-t border-linea bg-white/30 px-5 pb-8 pt-10 sm:pt-12 lg:px-8">
  <div class="mx-auto max-w-[1304px]">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-[1.4fr_.8fr_1fr_1.1fr] lg:gap-10">
      
      <!-- Columna 1: Marca y Misión -->
      <div>
        <a href={siteUrl('/')} class="michi-logo miche-logo--footer" aria-label="Michi Pop, inicio">
          <span class="michi-logo__letter michi-logo__m">M</span>
          <span class="michi-logo__letter michi-logo__i">I</span>
          <span class="michi-logo__letter michi-logo__c">C</span>
          <span class="michi-logo__letter michi-logo__h">H</span>
          <span class="michi-logo__letter michi-logo__i2">I</span>
          <span class="michi-logo__letter michi-logo__popletter">P</span>
          <span class="michi-logo__letter michi-logo__popletter michi-logo__popletter--o">O</span>
          <span class="michi-logo__letter michi-logo__popletter michi-logo__popletter--p">P</span>
        </a>
        <p class="mt-3 max-w-xs text-xs leading-5 text-tinta/80">
          Accesorios handmade en pequeño formato, con colores pastel y mucho amor.
        </p>
        <p class="mt-2 text-[11px] text-tinta/60">
          🚚 Envíos express con NACEX desde Valencia.
        </p>
      </div>

      <!-- Columna 2: Explora -->
      <div class="text-xs">
        <p class="mb-3 font-black uppercase tracking-[.18em] text-tinta">Explora</p>
        <div class="grid gap-2.5 text-tinta/80">
          <a href={siteUrl('/')} class="hover:underline hover:text-tinta">Inicio</a>
          <a href={siteUrl('/shop')} class="hover:underline hover:text-tinta">Tienda</a>
          <a href={siteUrl('/about')} class="hover:underline hover:text-tinta">Sobre nosotros</a>
          <a href={siteUrl('/faq')} class="hover:underline hover:text-tinta font-medium">Preguntas frecuentes</a>
          <a href={siteUrl('/contacto')} class="hover:underline hover:text-tinta font-medium">Contacto y Soporte</a>
        </div>
      </div>

      <!-- Columna 3: Envíos y Garantías -->
      <div class="text-xs">
        <p class="mb-3 font-black uppercase tracking-[.18em] text-tinta">Ayuda & Envíos</p>
        <div class="grid gap-2.5 text-tinta/80">
          <a href={siteUrl('/envios')} class="hover:underline hover:text-tinta">Envíos (NACEX 24/48h)</a>
          <a href={siteUrl('/devoluciones')} class="hover:underline hover:text-tinta">Devoluciones y reembolsos</a>
          <a href={siteUrl('/garantia')} class="hover:underline hover:text-tinta">Garantía legal (3 años)</a>
          <a href={siteUrl('/proteccion-michi')} class="hover:underline hover:text-tinta font-semibold text-rosa">🛡️ Protección Michi (12m)</a>
          <a href={siteUrl('/checkout')} class="hover:underline hover:text-tinta font-medium">Finalizar Compra</a>
        </div>
      </div>

      <!-- Columna 4: Información Legal -->
      <div class="text-xs">
        <p class="mb-3 font-black uppercase tracking-[.18em] text-tinta">Información Legal</p>
        <div class="grid gap-2.5 text-tinta/80">
          <a href={siteUrl('/aviso-legal')} class="hover:underline hover:text-tinta">Aviso legal</a>
          <a href={siteUrl('/privacidad')} class="hover:underline hover:text-tinta">Política de privacidad</a>
          <a href={siteUrl('/cookies')} class="hover:underline hover:text-tinta">Política de cookies</a>
          <a href={siteUrl('/condiciones-compra')} class="hover:underline hover:text-tinta">Condiciones de compra</a>
          <button 
            type="button" 
            onclick="window.dispatchEvent(new CustomEvent('open-cookie-settings'))" 
            class="text-left text-[11px] font-bold text-tinta/70 hover:text-tinta underline cursor-pointer pt-1"
          >
            ⚙️ Configurar cookies
          </button>
        </div>
      </div>

    </div>

    <!-- Copyright y Créditos -->
    <div class="mt-10 flex flex-col gap-2 border-t border-linea pt-5 text-[9px] uppercase tracking-[.14em] text-tinta/70 sm:text-[10px] sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} Michi Pop · Todos los derechos reservados</p>
      <p>Hecho a mano · Diseñado para disfrutar</p>
    </div>
  </div>
</footer>
