---
const BASE_URL = import.meta.env.BASE_URL;
const url = (path: string) => `${BASE_URL}${path.replace(/^\//, '')}`;
---
<footer class="border-t border-linea bg-white/25 px-5 pb-6 pt-8 sm:pt-10 lg:px-8">
  <div class="mx-auto max-w-[1304px]">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-[1.55fr_.8fr_.95fr_.8fr] lg:gap-10">
      <div>
        <a href={url('/')} class="display-font inline-block text-3xl font-black leading-none tracking-[-.07em]" aria-label="Michi Pop, inicio">
          <span class="text-rosa">MI</span><span class="text-amarillo">C</span><span class="text-lila">H</span><span class="text-menta">I</span><span class="ml-1 text-azul">POP</span>
        </a>
        <p class="mt-3 max-w-sm text-xs leading-5">Accesorios handmade en pequeño formato, con colores pastel y un poquito de caos bonito.</p>
      </div>
      <div class="text-xs">
        <p class="mb-3 font-black uppercase tracking-[.18em]">Explora</p>
        <div class="grid gap-2">
          <a href={url('/shop')} class="hover:underline">Tienda</a>
          <a href={url('/customize')} class="hover:underline">Personaliza</a>
          <a href={url('/about')} class="hover:underline">Sobre nosotros</a>
        </div>
      </div>
      <div class="text-xs">
        <p class="mb-3 font-black uppercase tracking-[.18em]">Ayuda</p>
        <div class="grid gap-2">
          <a href={url('/customize?feature=shipping')} class="hover:underline">Envíos y devoluciones</a>
          <a href={url('/customize?feature=faq')} class="hover:underline">Preguntas frecuentes</a>
          <a href={url('/customize?feature=contact')} class="hover:underline">Contacto</a>
        </div>
      </div>
      <div>
        <p class="mb-3 text-xs font-black uppercase tracking-[.18em]">Síguenos</p>
        <div class="flex items-center gap-3" aria-label="Redes sociales y contacto">
          <a class="social-asset grid h-9 w-9 place-items-center rounded-full border border-tinta bg-crema transition-transform duration-200 hover:-translate-y-0.5" href={url('/customize?feature=social')} aria-label="Instagram, próximamente">
            <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
          <a class="social-asset grid h-9 w-9 place-items-center rounded-full border border-tinta bg-crema transition-transform duration-200 hover:-translate-y-0.5" href={url('/customize?feature=social')} aria-label="TikTok, próximamente">
            <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true" fill="currentColor"><path d="M14.8 3h2.4c.2 2 1.1 3.3 3 4.1v2.5c-1.1 0-2.2-.3-3.2-.8v6.1a6.1 6.1 0 1 1-5.9-6.1v2.7a3.4 3.4 0 1 0 3.4 3.4V3Z"/></svg>
          </a>
          <a class="social-asset grid h-9 w-9 place-items-center rounded-full border border-tinta bg-crema transition-transform duration-200 hover:-translate-y-0.5" href={url('/customize?feature=social')} aria-label="Email, próximamente">
            <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="5" width="17" height="14" rx="2.2"/><path d="m5 7 7 5.3L19 7"/></svg>
          </a>
        </div>
      </div>
    </div>
    <div class="mt-7 flex flex-col gap-2 border-t border-linea pt-4 text-[9px] uppercase tracking-[.14em] sm:mt-8 sm:text-[10px] sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} Michi Pop · Handmade with love</p>
      <p>Hecho despacio · pensado para disfrutar</p>
    </div>
  </div>
</footer>
