---
import { BASE_URL, siteUrl } from '../../lib/site';
const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/shop', label: 'Tienda' },
  { href: '/customize', label: 'Personaliza' },
  { href: '/about', label: 'Sobre nosotros' },
];

const basePath = BASE_URL.replace(/\/+$/, '');
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const currentPath = basePath && pathname.startsWith(basePath)
  ? (pathname.slice(basePath.length).replace(/\/+$/, '') || '/')
  : pathname;
---
<header id="site-nav" class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-crema/90 transition-[background-color,border-color,backdrop-filter] duration-300">
  <div class="mx-auto flex h-[68px] max-w-[1304px] items-center justify-between px-5 sm:px-6 lg:px-7">
    <a href={siteUrl('/')} class="michi-logo shrink-0" aria-label="Michi Pop, inicio">
      <span class="michi-logo__letter michi-logo__m">M</span>
      <span class="michi-logo__letter michi-logo__i">I</span>
      <span class="michi-logo__letter michi-logo__c">C</span>
      <span class="michi-logo__letter michi-logo__h">H</span>
      <span class="michi-logo__letter michi-logo__i2">I</span>
      <span class="michi-logo__letter michi-logo__popletter">P</span>
      <span class="michi-logo__letter michi-logo__popletter michi-logo__popletter--o">O</span>
      <span class="michi-logo__letter michi-logo__popletter michi-logo__popletter--p">P</span>
    </a>
    <nav class="hidden items-center gap-5 text-[11px] font-black uppercase tracking-[.17em] md:flex" aria-label="Principal">
      {navItems.map((item) => (
        <a
          class:list={['nav-pill relative px-3.5 py-2 transition-[background-color,color,transform,box-shadow] duration-200', currentPath === item.href ? 'nav-pill--active' : '']}
          href={siteUrl(item.href)}
          aria-current={currentPath === item.href ? 'page' : undefined}
        >
          <span>{item.label}</span>
        </a>
      ))}
      <a class="soft-button whitespace-nowrap rounded-full border border-tinta px-4 py-2.5" href={siteUrl('/shop#cart')}>Cesta (0)</a>
    </nav>
    <button id="mobile-menu" class="grid h-10 w-10 place-items-center rounded-full border border-tinta md:hidden" aria-expanded="false" aria-controls="mobile-nav" aria-label="Abrir menú">
      <span class="grid gap-1.5" aria-hidden="true"><i class="block h-px w-4 bg-tinta"></i><i class="block h-px w-4 bg-tinta"></i><i class="block h-px w-4 bg-tinta"></i></span>
    </button>
  </div>
  <nav id="mobile-nav" class="hidden border-t border-linea bg-crema px-5 pb-5 pt-2 md:hidden" aria-label="Principal móvil">
    <div class="grid gap-1 pt-1 text-sm font-black uppercase tracking-[.14em]">
      {navItems.map((item) => (
        <a
          class={`rounded-xl px-3 py-3 ${currentPath === item.href ? 'bg-rosa text-tinta shadow-[inset_0_1px_0_rgba(255,255,255,.58)]' : 'hover:bg-white/60'}`}
          href={siteUrl(item.href)}
          aria-current={currentPath === item.href ? 'page' : undefined}
        >{item.label}</a>
      ))}
      <a class="mt-1 rounded-full border border-tinta bg-rosa px-4 py-3 text-center text-tinta shadow-[0_5px_0_rgba(244,137,160,.18)]" href={siteUrl('/shop#cart')}>Cesta (0)</a>
    </div>
  </nav>
</header>
<script>
  const nav = document.querySelector('#site-nav');
  const mobileButton = document.querySelector('#mobile-menu');
  const mobileNav = document.querySelector('#mobile-nav');
  const updateNav = () => nav?.classList.toggle('nav-solid', window.scrollY > 16);
  updateNav();
  window.addEventListener('scroll', updateNav, { passive: true });
  mobileButton?.addEventListener('click', () => {
    const open = mobileButton.getAttribute('aria-expanded') === 'true';
    mobileButton.setAttribute('aria-expanded', String(!open));
    mobileNav?.classList.toggle('hidden', open);
  });
</script>
