---
const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/shop', label: 'Tienda' },
  { href: '/customize', label: 'Personaliza' },
  { href: '/about', label: 'Sobre nosotros' },
];
const currentPath = Astro.url.pathname;
---
<header id="site-nav" class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-crema/80 transition-[background-color,border-color,backdrop-filter] duration-300">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 lg:px-8">
    <a href="/" class="display-font text-[1.45rem] font-black tracking-[-0.07em]" aria-label="Michi Pop, inicio">
      <span class="text-rosa">MI</span><span class="text-amarillo">C</span><span class="text-lila">H</span><span class="text-menta">I</span><span class="ml-1 text-azul">POP</span>
    </a>

    <nav class="hidden items-center gap-8 text-[11px] font-black uppercase tracking-[.18em] md:flex" aria-label="Principal">
      {navItems.map((item) => (
        <a class:list={['relative py-2 transition-colors hover:text-tinta', currentPath === item.href ? 'after:absolute after:inset-x-0 after:-bottom-0.5 after:mx-auto after:h-0.5 after:w-5 after:rounded-full after:bg-rosa' : '']} href={item.href}>{item.label}</a>
      ))}
      <a class="soft-button rounded-full border border-tinta px-4 py-2.5" href="/shop#cart">Cesta (0)</a>
    </nav>

    <button id="mobile-menu" class="rounded-full border border-tinta px-3 py-2 text-[10px] font-black uppercase tracking-[.14em] md:hidden" aria-expanded="false" aria-controls="mobile-nav">Menú</button>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-linea bg-crema/97 px-5 pb-5 pt-3 md:hidden" aria-label="Principal móvil">
    <div class="grid gap-1 text-sm font-semibold uppercase tracking-[.14em]">
      {navItems.map((item) => <a class="rounded-xl px-3 py-3 hover:bg-white/60" href={item.href}>{item.label}</a>)}
      <a class="rounded-xl bg-tinta px-3 py-3 text-crema" href="/shop#cart">Cesta (0)</a>
    </div>
  </nav>
</header>
<script>
  const nav = document.querySelector('#site-nav');
  const mobileButton = document.querySelector('#mobile-menu');
  const mobileNav = document.querySelector('#mobile-nav');
  const updateNav = () => nav?.classList.toggle('nav-solid', window.scrollY > 16);
  updateNav();
  window.addEventListener('scroll', updateNav, { passive: true });
  mobileButton?.addEventListener('click', () => {
    const open = mobileButton.getAttribute('aria-expanded') === 'true';
    mobileButton.setAttribute('aria-expanded', String(!open));
    mobileNav?.classList.toggle('hidden', open);
  });
</script>
