---
import KawaiiHeading from '../kawaii/KawaiiHeading.astro';
import Heart from '../icons/Heart.astro';
import Star from '../icons/Star.astro';
---
<section class="relative overflow-hidden px-5 pb-7 pt-24 lg:px-8 lg:pt-28">
  <div class="mx-auto grid max-w-7xl items-end gap-4 lg:grid-cols-[.93fr_1.07fr]">
    <div class="pb-5 lg:pb-8">
      <div class="mb-5 flex items-center gap-2.5 text-[10px] font-black uppercase tracking-[.18em]">
        <Star size={17} />
        <span>Hecho a mano, con amor</span>
      </div>

      <KawaiiHeading
        text="PEQUEÑOS DETALLES"
        colors={['rosa','amarillo','lila','menta','naranja','azul','lima','rosa','amarillo','lila','menta','azul','rosa','amarillo','lila','menta']}
        size="lg"
        class="justify-start [&_h1]:justify-start [&_h1]:max-w-[700px]"
      />

      <div class="mt-3 flex items-end gap-3">
        <p class="brand-serif text-5xl leading-[.9] tracking-[-.045em] sm:text-6xl lg:text-7xl">gran alegría.</p>
        <Heart size={24} fill="#F489A0" class="mb-1" />
      </div>

      <p class="mt-5 max-w-xl text-sm leading-6 sm:text-base">Accesorios handmade en pequeño formato, con colores pastel y un poquito de caos bonito.</p>
      <a href="/shop" class="soft-button mt-6 inline-flex items-center gap-3 rounded-full bg-tinta px-6 py-3.5 text-sm font-bold text-crema shadow-[0_7px_0_rgba(48,44,43,.14)]">
        Descubre la colección <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="relative min-h-[24rem] sm:min-h-[31rem] lg:min-h-[36rem]">
      <img
        src="/brand/hero-maker.webp"
        alt="Ilustración de una joven emprendedora creando accesorios con cuentas de colores"
        width="996"
        height="629"
        fetchpriority="high"
        decoding="async"
        class="absolute bottom-0 right-0 h-auto w-full max-w-[760px] object-contain mix-blend-multiply"
      />
      <img
        src="/brand/pequenas-ideas-grandes-suenos.webp"
        alt="Pequeñas ideas, grandes sueños"
        width="482"
        height="209"
        loading="eager"
        decoding="async"
        class="absolute right-[3%] top-[23%] w-[150px] mix-blend-multiply sm:w-[185px] lg:w-[205px]"
      />
      <div class="absolute left-[14%] top-[20%] rotate-[-12deg]"><Heart size={33} fill="#F489A0" /></div>
      <div class="absolute left-[5%] bottom-[17%] rotate-[-8deg]"><Star size={38} /></div>
    </div>
  </div>
</section>
