---
import KawaiiHeading from '../kawaii/KawaiiHeading.astro';
import Heart from '../icons/Heart.astro';
import Star from '../icons/Star.astro';
import BalloonDog from '../icons/BalloonDog.astro';
---
<section class="relative px-4 pb-10 pt-24 sm:px-5 lg:px-8 lg:pt-28">
  <div class="relative mx-auto max-w-7xl overflow-hidden rounded-[2.8rem_1.4rem_3.4rem_1.8rem] border border-tinta bg-amarillo px-6 py-12 shadow-[0_26px_70px_rgba(73,47,61,.10)] sm:px-10 sm:py-16 lg:min-h-[680px] lg:px-16">
    <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-white/20"></div>
    <div class="absolute -bottom-20 left-1/2 h-48 w-48 rounded-full bg-rosa/20 blur-2xl"></div>
    <div class="absolute left-[7%] top-[18%] rotate-[-10deg]"><Star size={36} /></div>
    <div class="absolute right-[8%] top-[14%] rotate-[12deg]"><Heart size={46} fill="#EE8FAF" /></div>
    <div class="absolute bottom-[14%] left-[8%] rotate-[-6deg]"><BalloonDog size={76} /></div>

    <div class="relative z-10 mx-auto flex max-w-5xl flex-col items-center text-center">
      <p class="text-[11px] font-black uppercase tracking-[.28em]">Tu próximo pequeño vicio</p>
      <KawaiiHeading text="MICHI POP" colors={['rosa','amarillo','lila','menta','naranja','azul','lima','rosa']} size="xl" class="mt-7 w-full" />
      <div class="mt-4 flex items-center justify-center gap-3">
        <span class="accent-font text-3xl leading-none sm:text-4xl">handmade with love</span>
        <Heart size={25} fill="#EE8FAF" />
      </div>
      <p class="mx-auto mt-6 max-w-2xl text-sm leading-6 sm:text-base">Piezas pequeñas. Colores demasiado bonitos. Cero ganas de parecerse a todo lo demás.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/shop" class="soft-button rounded-full border border-tinta bg-tinta px-7 py-3.5 text-sm font-bold text-crema shadow-[0_8px_0_rgba(73,47,61,.16)]">Entrar en la tienda</a>
        <a href="#pop-del-dia" class="soft-button rounded-full border border-tinta bg-white/35 px-7 py-3.5 text-sm font-bold">Ver los pops</a>
      </div>
    </div>
  </div>
</section>
