---
import KawaiiHeading from '../kawaii/KawaiiHeading.astro';
import Heart from '../icons/Heart.astro';
import Star from '../icons/Star.astro';
import BalloonDog from '../icons/BalloonDog.astro';
---
<section class="relative flex min-h-screen items-center overflow-hidden px-5 pb-12 pt-28 lg:px-8">
  <div class="mx-auto grid w-full max-w-7xl items-center gap-10 lg:grid-cols-[1.15fr_.85fr]">
    <div class="relative z-10">
      <p class="mb-6 text-xs font-bold uppercase tracking-[.24em]">Accesorios handmade · Barcelona</p>
      <KawaiiHeading text="MICHI POP" colors={['rosa','amarillo','lila','menta','naranja','azul','lima','rosa']} size="xl" class="justify-start" />
      <div class="mt-8 flex flex-wrap items-end gap-x-5 gap-y-4">
        <p class="accent-font text-4xl leading-none md:text-5xl">handmade with love</p>
        <Heart size={34} fill="#EE8FAF" />
      </div>
      <p class="mt-6 max-w-xl text-base leading-7 md:text-lg">Llaveros, collares y pequeños accesorios hechos a mano para gente que prefiere llevar un poco de color encima.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/shop" class="soft-button rounded-full border border-tinta bg-tinta px-6 py-3 text-sm font-bold text-crema">Ver la tienda</a>
        <a href="/about" class="soft-button rounded-full border border-tinta px-6 py-3 text-sm font-bold">Conocer Michi Pop</a>
      </div>
    </div>

    <div class="relative min-h-[26rem] lg:min-h-[34rem]">
      <div class="absolute right-[5%] top-[8%] h-56 w-56 rounded-full bg-white/45 blur-[1px] md:h-72 md:w-72"></div>
      <div class="absolute left-[11%] top-[13%] rotate-[-8deg]"><Star size={47} /></div>
      <div class="absolute right-[10%] top-[16%] rotate-[11deg]"><Heart size={58} fill="#EE8FAF" /></div>
      <div class="absolute left-[8%] top-[36%] rotate-[-7deg]"><BalloonDog size={105} /></div>
      <div class="absolute right-[13%] top-[39%] h-24 w-24 rounded-[2rem] bg-menta/60 rotate-[16deg]"></div>
      <div class="absolute left-[25%] top-[46%] h-36 w-36 rounded-full bg-amarillo/65"></div>
      <div class="absolute right-[24%] top-[55%] h-20 w-20 rounded-[1.4rem] bg-lila/80 rotate-[-16deg]"></div>
      <div class="absolute bottom-[4%] left-[17%] rotate-[7deg] rounded-[2.5rem] border border-tinta bg-white/55 px-6 py-4 shadow-[0_12px_24px_rgba(73,47,61,.08)]">
        <div class="flex items-center gap-3">
          <span class="h-3 w-3 rounded-full bg-rosa"></span><span class="h-3 w-3 rounded-full bg-amarillo"></span><span class="h-3 w-3 rounded-full bg-lila"></span>
          <span class="text-xs font-bold uppercase tracking-[.18em]">hecho despacio</span>
        </div>
      </div>
    </div>
  </div>
</section>
