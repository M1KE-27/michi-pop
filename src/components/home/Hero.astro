---
import { siteUrl } from '../../lib/site';
import KawaiiHeading from '../kawaii/KawaiiHeading.astro';
import Heart from '../icons/Heart.astro';
import Star from '../icons/Star.astro';
---
<section class="relative overflow-hidden px-5 pb-4 pt-20 sm:pb-6 lg:px-8 lg:pt-24">
  <div class="mx-auto grid max-w-[1304px] items-center gap-1 lg:grid-cols-[.96fr_1.04fr]">
    <div class="pb-2 lg:pb-5">
      <div class="mb-4 flex items-center gap-2.5 text-[10px] font-black uppercase tracking-[.18em] sm:text-[11px]">
        <Star size={18} />
        <span>Hecho a mano, con amor</span>
      </div>

      <KawaiiHeading
        text="PEQUEÑOS DETALLES"
        colors={['rosa','amarillo','lila','menta','naranja','azul','lima','rosa','amarillo','lila','menta','azul','rosa','amarillo','lila','menta']}
        size="sm"
        class="justify-start [&_h1]:justify-start [&_h1]:max-w-[650px]"
      />

      <div class="mt-3 flex items-end gap-3">
        <p class="brand-serif text-5xl leading-[.9] tracking-[-.045em] sm:text-6xl lg:text-[4.35rem]">gran alegría.</p>
        <Heart size={24} fill="#F489A0" class="mb-1.5" />
      </div>

      <p class="mt-4 max-w-[33rem] text-sm leading-6 sm:text-base">Accesorios handmade en pequeño formato, con colores pastel y un poquito de caos bonito.</p>
      <a href={siteUrl('/shop')} class="soft-button mt-5 inline-flex items-center gap-3 rounded-full bg-rosa px-6 py-3.5 text-sm font-bold text-tinta shadow-[0_7px_0_rgba(244,137,160,.22)]">
        Descubre la colección <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="relative min-h-[21rem] sm:min-h-[27rem] lg:min-h-[31rem]">
      <img
        src={siteUrl('/brand/hero-maker.webp')}
        alt="Ilustración de una joven emprendedora creando accesorios con cuentas de colores"
        width="996"
        height="629"
        sizes="(min-width: 1024px) 55vw, 100vw"
        fetchpriority="high"
        decoding="async"
        class="hero-art pointer-events-none absolute bottom-0 right-[-1%] h-auto w-[108%] max-w-[820px] object-contain"
      />
      <img
        src={siteUrl('/brand/pequenas-ideas-grandes-suenos.webp')}
        alt="Pequeñas ideas, grandes sueños"
        width="482"
        height="209"
        sizes="190px"
        loading="eager"
        decoding="async"
        class="hero-note pointer-events-none absolute right-[-1%] top-[4%] w-[150px] sm:right-[0] sm:w-[175px] lg:w-[190px]"
      />
      <div class="absolute left-[12%] top-[12%] rotate-[-11deg]"><Heart size={32} fill="#F489A0" /></div>
      <div class="absolute left-[4%] bottom-[17%] rotate-[-8deg]"><Star size={39} /></div>
    </div>
  </div>
</section>
