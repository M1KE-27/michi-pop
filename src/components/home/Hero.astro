---
import { siteUrl } from '../../lib/site';
import Heart from '../icons/Heart.astro';
import Star from '../icons/Star.astro';
---
<section class="hero relative overflow-hidden px-4 pb-10 pt-[84px] sm:px-6 sm:pb-12 sm:pt-[92px] lg:px-8 lg:pb-14 xl:pt-[104px]">
  <div class="hero-grid mx-auto grid max-w-[1440px] items-center gap-8 lg:gap-10 xl:grid-cols-[.92fr_1.08fr] xl:gap-8 2xl:gap-14">
    <div class="hero-copy relative z-10 mx-auto w-full max-w-[680px] xl:mx-0 xl:max-w-[620px]">
      <div class="mb-3 flex items-center gap-2.5 text-[10px] font-black uppercase tracking-[.18em] sm:mb-4 sm:text-[11px]">
        <Star size={18} />
        <span>Hecho a mano, con amor</span>
      </div>

      <div class="hero-logo-wrap relative mx-auto w-full max-w-[570px] xl:mx-0 xl:max-w-[590px]">
        <img
          src={siteUrl('/brand/michi-pop-logo.webp')}
          alt="Michi Pop — Handmade with love"
          width="1536"
          height="1024"
          sizes="(min-width: 1280px) 43vw, (min-width: 768px) 72vw, 96vw"
          fetchpriority="high"
          decoding="async"
          class="hero-logo block h-auto w-full object-contain"
        />
      </div>

      <p class="hero-description mt-2 max-w-[34rem] text-[15px] leading-6 sm:mt-3 sm:text-base sm:leading-7 xl:mt-1">Accesorios handmade en pequeño formato, con colores pastel y un poquito de caos bonito.</p>
      <a href={siteUrl('/shop')} class="soft-button mt-5 inline-flex items-center gap-3 rounded-full bg-rosa px-6 py-3.5 text-sm font-bold text-tinta shadow-[0_7px_0_rgba(244,137,160,.22)] transition-transform duration-200 sm:mt-6 sm:px-7">
        Descubre la colección <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="hero-visual relative mx-auto min-h-[330px] w-full max-w-[760px] sm:min-h-[450px] lg:min-h-[520px] xl:mx-0 xl:min-h-[560px] 2xl:min-h-[610px]">
      <img
        src={siteUrl('/brand/hero-maker.webp')}
        alt="Ilustración de una joven emprendedora creando accesorios con cuentas de colores"
        width="996"
        height="629"
        sizes="(min-width: 1280px) 55vw, (min-width: 768px) 92vw, 100vw"
        fetchpriority="high"
        decoding="async"
        class="hero-art pointer-events-none absolute bottom-0 left-1/2 h-auto w-[min(100%,760px)] -translate-x-1/2 object-contain xl:left-auto xl:right-[-2%] xl:translate-x-0"
      />
      <img
        src={siteUrl('/brand/pequenas-ideas-grandes-suenos.webp')}
        alt="Pequeñas ideas, grandes sueños"
        width="482"
        height="209"
        sizes="(min-width: 1280px) 190px, 175px"
        loading="eager"
        decoding="async"
        class="hero-note pointer-events-none absolute right-[2%] top-[3%] w-[150px] sm:right-[5%] sm:w-[175px] xl:right-[2%] xl:w-[190px]"
      />
      <div class="absolute left-[8%] top-[12%] rotate-[-11deg] motion-safe:animate-[hero-float_4s_ease-in-out_infinite] sm:left-[11%]"><Heart size={32} fill="#F489A0" /></div>
      <div class="absolute left-[3%] bottom-[15%] rotate-[-8deg] motion-safe:animate-[hero-float_5s_ease-in-out_1s_infinite] sm:left-[7%]"><Star size={39} /></div>
    </div>
  </div>

  <style>
    @keyframes hero-float {
      0%, 100% { transform: translateY(0) rotate(-11deg); }
      50% { transform: translateY(-6px) rotate(-8deg); }
    }

    .hero-logo-wrap {
      animation: hero-logo-in 700ms cubic-bezier(.2,.8,.2,1) both;
    }

    @keyframes hero-logo-in {
      from { opacity: 0; transform: translateY(10px) scale(.985); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    @media (min-width: 768px) and (max-width: 1279px) {
      .hero-grid { max-width: 900px; }
      .hero-copy { text-align: center; }
      .hero-copy > div:first-child { justify-content: center; }
      .hero-description { margin-inline: auto; }
      .hero-logo-wrap { max-width: 610px; }
      .hero-visual { max-width: 820px; }
    }

    @media (max-width: 767px) {
      .hero-grid { gap: 1.5rem; }
      .hero-copy { max-width: 100%; }
      .hero-logo-wrap { max-width: 100%; }
      .hero-description { max-width: 31rem; }
      .hero-visual { min-height: 300px; }
      .hero-art { width: min(108%, 680px); }
      .hero-note { right: 0; width: 125px; }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-logo-wrap { animation: none; }
    }
  </style>
</section>
