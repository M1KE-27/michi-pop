---
import KawaiiHeading from '../kawaii/KawaiiHeading.astro';
import Heart from '../icons/Heart.astro';
import Star from '../icons/Star.astro';
---
<section class="relative overflow-hidden px-5 pb-5 pt-24 sm:pb-7 lg:px-8 lg:pt-28">
  <div class="mx-auto grid max-w-[1304px] items-end gap-2 lg:grid-cols-[.93fr_1.07fr]">
    <div class="pb-4 lg:pb-7">
      <div class="mb-5 flex items-center gap-2.5 text-[10px] font-black uppercase tracking-[.18em] sm:text-[11px]">
        <Star size={18} />
        <span>Hecho a mano, con amor</span>
      </div>

      <KawaiiHeading
        text="PEQUEÑOS DETALLES"
        colors={['rosa','amarillo','lila','menta','naranja','azul','lima','rosa','amarillo','lila','menta','azul','rosa','amarillo','lila','menta']}
        size="sm"
        class="justify-start [&_h1]:justify-start [&_h1]:max-w-[650px]"
      />

      <div class="mt-4 flex items-end gap-3">
        <p class="brand-serif text-5xl leading-[.9] tracking-[-.045em] sm:text-6xl lg:text-[4.35rem]">gran alegría.</p>
        <Heart size={24} fill="#F489A0" class="mb-1.5" />
      </div>

      <p class="mt-5 max-w-[33rem] text-sm leading-6 sm:text-base">Accesorios handmade en pequeño formato, con colores pastel y un poquito de caos bonito.</p>
      <a href="/shop" class="soft-button mt-6 inline-flex items-center gap-3 rounded-full bg-tinta px-6 py-3.5 text-sm font-bold text-crema shadow-[0_7px_0_rgba(48,44,43,.14)]">
        Descubre la colección <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="relative min-h-[22rem] sm:min-h-[28rem] lg:min-h-[35rem]">
      <img
        src="/brand/hero-maker.webp"
        alt="Ilustración de una joven emprendedora creando accesorios con cuentas de colores"
        width="996"
        height="629"
        fetchpriority="high"
        decoding="async"
        class="hero-art pointer-events-none absolute bottom-0 right-[-2%] h-auto w-[108%] max-w-[820px] object-contain"
      />
      <img
        src="/brand/pequenas-ideas-grandes-suenos.webp"
        alt="Pequeñas ideas, grandes sueños"
        width="482"
        height="209"
        loading="eager"
        decoding="async"
        class="hero-note pointer-events-none absolute right-[4%] top-[21%] w-[155px] sm:right-[4%] sm:w-[185px] lg:w-[205px]"
      />
      <div class="absolute left-[13%] top-[18%] rotate-[-11deg]"><Heart size={32} fill="#F489A0" /></div>
      <div class="absolute left-[4%] bottom-[18%] rotate-[-8deg]"><Star size={39} /></div>
    </div>
  </div>
</section>
