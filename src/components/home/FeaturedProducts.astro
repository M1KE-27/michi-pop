---
import { products } from '../../data/products';
import ProductCard from '../shop/ProductCard.astro';
import RevealOnScroll from '../motion/RevealOnScroll';

const featured = products;
---
<section id="pop-del-dia" class="px-5 py-24 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <RevealOnScroll variant="side">
      <div class="mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-[.22em]">La colección actual</p>
          <h2 class="display-font mt-3 text-5xl font-black tracking-[-.07em] md:text-7xl">Los seis pops.</h2>
          <p class="mt-4 max-w-xl text-sm leading-6 text-tinta/75">Seis piezas, seis excusas para llevar un poco de color encima. Todas a 2,00 € en este prototipo.</p>
        </div>
        <a class="soft-button rounded-full border border-tinta px-5 py-3 text-sm font-bold" href="/shop">Ver catálogo completo →</a>
      </div>
    </RevealOnScroll>
    <div class="grid gap-x-5 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((product, index) => (
        <RevealOnScroll client:load variant={index % 3 === 0 ? 'rise' : index % 3 === 1 ? 'tilt' : 'scale'} class={index % 2 ? 'lg:translate-y-8' : ''}>
          <ProductCard product={product} />
        </RevealOnScroll>
      ))}
    </div>
  </div>
</section>
