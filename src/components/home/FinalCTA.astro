---
import { siteUrl } from '../../lib/site';
import KawaiiHeading from '../kawaii/KawaiiHeading.astro';
---
<section class="px-5 py-24 lg:px-8">
  <div class="mx-auto max-w-7xl overflow-hidden rounded-[2.5rem] border border-tinta bg-amarillo px-6 py-16 text-center md:px-12 md:py-24">
    <p class="text-xs font-bold uppercase tracking-[.22em]">Tu próximo pequeño vicio</p>
    <KawaiiHeading text="PICK POP" colors={['rosa','lila','menta','naranja','azul','rosa','amarillo','menta']} size="lg" class="mt-7" />
    <p class="mx-auto mt-7 max-w-xl text-base leading-7">Piezas pequeñas. Colores demasiado bonitos. Cero ganas de parecerse a todo lo demás.</p>
    <a href={siteUrl('/shop')} class="soft-button mt-8 inline-flex rounded-full border border-tinta bg-tinta px-7 py-4 text-sm font-bold text-crema">Entrar en la tienda</a>
  </div>
</section>
