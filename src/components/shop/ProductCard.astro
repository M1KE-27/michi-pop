---
import type { Product } from '../../data/products';
import Heart from '../icons/Heart.astro';

interface Props { product: Product; compact?: boolean; }
const { product, compact = false } = Astro.props;
const colorClass: Record<string, string> = {
  rosa: 'bg-rosa', amarillo: 'bg-amarillo', lila: 'bg-lila', menta: 'bg-menta', naranja: 'bg-naranja', lima: 'bg-lima', azul: 'bg-azul',
};
---
<article class={`group relative ${compact ? '' : 'border-t border-linea pt-4'}`}>
  <a href={`/product/${product.slug}`} class="block">
    <div class="relative overflow-hidden rounded-[2rem] border border-linea bg-white/50 p-5 transition-transform duration-300 group-hover:-translate-y-1">
      <div class="absolute right-4 top-4 opacity-0 transition-opacity duration-300 group-hover:opacity-100"><Heart size={22} fill="#F7D24A" /></div>
      <div class="grid min-h-56 place-items-center rounded-[1.5rem] bg-crema">
        {product.image === 'bubble-dog' && <div class="relative"><div class="text-[7rem] leading-none">●</div><div class="absolute left-12 top-8 text-5xl">●</div><div class="absolute left-20 top-14 text-4xl">●</div><div class="absolute left-32 top-6 text-5xl">●</div></div>}
        {product.image === 'love-charm' && <div class="display-font text-[5.5rem] font-black text-rosa">LOVE</div>}
        {product.image === 'candy-collar' && <div class="flex flex-wrap items-center justify-center gap-2 max-w-48">{['rosa','azul','lila','amarillo','menta','rosa','azul','lila','amarillo'].map((c) => <span class={`h-8 w-8 rounded-full border border-tinta/10 ${colorClass[c]}`}></span>)}</div>}
        {product.image === 'mint-heart' && <div class="display-font text-8xl text-menta">♥</div>}
        {product.image === 'flower-party' && <div class="display-font text-8xl text-amarillo">✽</div>}
        {product.image === 'candy-clip' && <div class="h-28 w-16 rounded-[1.2rem] border-[8px] border-lila rotate-12"></div>}
      </div>
    </div>
    <div class="mt-4 flex items-start justify-between gap-4">
      <div>
        <h3 class="display-font text-2xl font-extrabold tracking-[-.04em]">{product.name}</h3>
        <div class="mt-2 flex gap-1.5" aria-label={`Colores: ${product.colors.join(', ')}`}>
          {product.colors.map((color) => <span class={`h-3 w-3 rounded-full border border-tinta/10 ${colorClass[color]}`}></span>)}
        </div>
      </div>
      <span class="font-semibold">{product.price.toFixed(2).replace('.', ',')} €</span>
    </div>
    <div class="mt-3 flex items-center justify-between text-xs uppercase tracking-[.14em]">
      <span class={product.available ? 'text-tinta' : 'text-tinta/50'}>{product.available ? 'Disponible' : 'Agotado'}</span>
      <span class="soft-button rounded-full border border-tinta px-3 py-1.5">Ver pieza</span>
    </div>
  </a>
</article>
