---
import { siteUrl } from '../../lib/site';
import type { Product } from '../../data/products';

interface Props { product: Product; compact?: boolean; }
const { product, compact = false } = Astro.props;

const colorClass: Record<string, string> = {
  rosa: 'bg-rosa',
  amarillo: 'bg-amarillo',
  lila: 'bg-lila',
  menta: 'bg-menta',
  naranja: 'bg-naranja',
  lima: 'bg-lima',
  azul: 'bg-azul',
};
---

<article class={`group ${compact ? '' : 'border-t border-linea pt-4'}`}>
  <a href={siteUrl(`/product/${product.slug}`)} class="block">
    <div class="relative overflow-hidden rounded-[1.15rem] bg-[#F8EEE7] transition-transform duration-300 group-hover:-translate-y-1">
      <img
        src={siteUrl(`/products/${product.image}`)}
        alt={`${product.name}, ${product.category} handmade de Michi Pop`}
        width="400"
        height="400"
        sizes="(min-width: 1024px) 16vw, (min-width: 640px) 33vw, 50vw"
        loading={compact ? 'eager' : 'lazy'}
        decoding="async"
        class="aspect-square w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.035]"
      />

      <span class="pointer-events-none absolute inset-x-3 bottom-3 flex justify-end opacity-0 transition-opacity duration-300 group-hover:opacity-100">
        <span class="rounded-full border border-tinta bg-crema/95 px-3 py-1.5 text-[10px] font-black uppercase tracking-[.14em]">
          Ver pieza
        </span>
      </span>
    </div>

    <div class="mt-3 flex items-start justify-between gap-3">
      <div class="min-w-0 flex-1">
        <h3 class="display-font text-base font-extrabold tracking-[-.025em] sm:text-lg">
          {product.name}
        </h3>

        <div
          class="mt-1.5 flex gap-1.5"
          aria-label={`Colores disponibles: ${product.colors.join(', ')}`}
        >
          {product.colors.map((color) => (
            <span
              class={`h-2.5 w-2.5 shrink-0 rounded-full border border-tinta/10 ${colorClass[color]}`}
              title={color.charAt(0).toUpperCase() + color.slice(1)}
              aria-hidden="true"
            ></span>
          ))}
        </div>
      </div>

      <span class="whitespace-nowrap pt-0.5 text-sm font-semibold">
        {product.price.toFixed(2).replace('.', ',')} €
      </span>
    </div>

    <p class="mt-2.5 line-clamp-3 text-[11px] leading-[1.5] text-tinta/65 sm:text-xs">
      {product.description}
    </p>
  </a>
</article>
