  <g fill={fill} stroke="#8b566d" stroke-width="1.6" stroke-linejoin="round">
    <ellipse cx="18" cy="39" rx="10" ry="20" transform="rotate(-34 18 39)" />
    <ellipse cx="31" cy="22" rx="12" ry="8" transform="rotate(-12 31 22)" />
    <ellipse cx="49" cy="18" rx="10" ry="8" transform="rotate(14 49 18)" />
