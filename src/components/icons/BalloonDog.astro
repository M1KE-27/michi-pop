    <ellipse cx="80" cy="31" rx="8" ry="6" transform="rotate(20 80 31)" />
    <ellipse cx="62" cy="43" rx="11" ry="8" transform="rotate(-18 62 43)" />
    <ellipse cx="46" cy="54" rx="11" ry="8" transform="rotate(18 46 54)" />
