---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import KawaiiHeading from '../components/kawaii/KawaiiHeading.astro';
import Heart from '../components/icons/Heart.astro';
import Star from '../components/icons/Star.astro';
import RevealOnScroll from '../components/motion/RevealOnScroll';
import { siteUrl } from '../lib/site';
---
<BaseLayout title="Sobre nosotros" description="La historia y forma de hacer de Michi Pop.">
  <Nav />
  <main class="px-5 pb-24 pt-28 sm:pt-32 lg:px-8 lg:pt-36">
    <div class="mx-auto max-w-[1304px]">
      <RevealOnScroll client:load variant="rise">
        <section class="grid items-center gap-10 lg:grid-cols-[.96fr_1.04fr] lg:gap-14">
          <div class="max-w-2xl">
            <div class="mb-5 flex items-center gap-2 text-[10px] font-black uppercase tracking-[.2em] sm:text-[11px]">
              <Star size={17} />
              <span>Pequeñas ideas, hechas despacio</span>
            </div>
            <KawaiiHeading text="PEQUEÑAS PIEZAS" colors={['rosa','amarillo','lila','menta','azul','naranja','rosa','lima','menta','lila','azul','rosa','amarillo','menta']} size="lg" class="justify-start [&_h1]:justify-start" />
            <p class="brand-serif mt-5 max-w-xl text-4xl leading-[.95] tracking-[-.035em] sm:text-5xl lg:text-[4.15rem]">mucho cuidado detrás.</p>
            <p class="mt-6 max-w-xl text-sm leading-6 sm:text-base sm:leading-7">Michi Pop nace de una idea sencilla: hacer accesorios pequeños que tengan algo de juguete, algo de objeto de diseño y bastante personalidad.</p>
            <div class="mt-7 flex flex-wrap gap-2">
              <span class="rounded-full border border-tinta px-4 py-2 text-[10px] font-black uppercase tracking-[.16em]">Hecho a mano</span>
              <span class="rounded-full border border-tinta px-4 py-2 text-[10px] font-black uppercase tracking-[.16em]">Series pequeñas</span>
              <span class="rounded-full border border-tinta px-4 py-2 text-[10px] font-black uppercase tracking-[.16em]">Mucho color</span>
            </div>
          </div>

          <div class="about-board relative overflow-hidden rounded-[2rem] border border-tinta bg-rosa p-5 sm:p-7">
            <div class="about-orb about-orb--yellow"></div>
            <div class="about-orb about-orb--mint"></div>
            <div class="relative min-h-[24rem] rounded-[1.35rem] border border-tinta/10 bg-crema p-5 sm:min-h-[28rem]">
              <div class="flex items-center justify-between text-[10px] font-black uppercase tracking-[.18em]">
                <span>Hecho con cariño</span>
                <Heart size={19} fill="#F489A0" />
              </div>
              <div class="absolute inset-x-0 top-1/2 grid -translate-y-1/2 place-items-center">
                <img src={siteUrl('/brand/flower-bead.webp')} alt="Flor de cuentas de colores de Michi Pop" width="420" height="340" loading="eager" decoding="async" class="about-flower h-auto w-[70%] max-w-[300px]" />
              </div>
              <div class="absolute bottom-5 left-5 max-w-[12rem] sm:max-w-[15rem]">
                <p class="brand-serif text-3xl leading-none sm:text-4xl">lo pequeño también deja huella.</p>
              </div>
              <div class="absolute bottom-5 right-5 rotate-[-5deg] rounded-full border border-tinta bg-amarillo px-4 py-2 text-[10px] font-black uppercase tracking-[.16em]">Michi Pop</div>
            </div>
          </div>
        </section>
      </RevealOnScroll>

      <section class="mt-20 border-y border-linea py-8 sm:mt-24 sm:py-10">
        <div class="grid gap-5 sm:grid-cols-3">
          <RevealOnScroll client:load variant="side">
            <article class="about-card rounded-[1.25rem] bg-rosa/80 p-6 sm:p-7">
              <p class="text-[10px] font-black uppercase tracking-[.2em]">01</p>
              <h2 class="brand-serif mt-3 text-3xl leading-none">Pocas piezas.</h2>
              <p class="mt-4 text-sm leading-6">El catálogo no crece por obligación. Cada pieza tiene un motivo y su propio pequeño universo.</p>
            </article>
          </RevealOnScroll>
          <RevealOnScroll client:load variant="rise">
            <article class="about-card rounded-[1.25rem] bg-amarillo/80 p-6 sm:p-7">
              <p class="text-[10px] font-black uppercase tracking-[.2em]">02</p>
              <h2 class="brand-serif mt-3 text-3xl leading-none">Mucho color.</h2>
              <p class="mt-4 text-sm leading-6">Pasteles, formas redondeadas y pequeños acentos para que todo se sienta alegre sin gritar.</p>
            </article>
          </RevealOnScroll>
          <RevealOnScroll client:load variant="tilt">
            <article class="about-card rounded-[1.25rem] bg-menta/80 p-6 sm:p-7">
              <p class="text-[10px] font-black uppercase tracking-[.2em]">03</p>
              <h2 class="brand-serif mt-3 text-3xl leading-none">Cero plantilla.</h2>
              <p class="mt-4 text-sm leading-6">Michi Pop no intenta parecer una tienda genérica. Quiere sentirse hecho por alguien.</p>
            </article>
          </RevealOnScroll>
        </div>
      </section>

      <RevealOnScroll client:load variant="scale">
        <section class="about-quote relative mt-10 overflow-hidden rounded-[1.5rem] border border-tinta bg-amarillo px-6 py-10 text-center sm:px-10 sm:py-14">
          <div class="absolute left-6 top-5 rotate-[-12deg]"><Star size={27} /></div>
          <div class="absolute right-7 top-9 rotate-[10deg]"><Heart size={25} fill="#F489A0" /></div>
          <p class="text-[10px] font-black uppercase tracking-[.22em]">La idea detrás de cada detalle</p>
          <p class="brand-serif mx-auto mt-4 max-w-3xl text-4xl leading-[.95] tracking-[-.035em] sm:text-5xl">hacer algo pequeño que quieras volver a mirar.</p>
        </section>
      </RevealOnScroll>
    </div>
  </main>
  <Footer />
</BaseLayout>
