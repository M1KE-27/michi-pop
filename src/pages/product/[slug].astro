---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/layout/Nav.astro';
import Footer from '../../components/layout/Footer.astro';
import { products } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const BASE_URL = import.meta.env.BASE_URL;
const url = (path: string) => `${BASE_URL}${path.replace(/^\//, '')}`;
const colorClass: Record<string, string> = {
  rosa: 'bg-rosa', amarillo: 'bg-amarillo', lila: 'bg-lila', menta: 'bg-menta', naranja: 'bg-naranja', lima: 'bg-lima', azul: 'bg-azul',
};
---
<BaseLayout title={product.name} description={product.description}>
  <Nav />
  <main class="px-5 pb-20 pt-32 lg:px-8 lg:pt-36">
    <div class="mx-auto max-w-7xl">
      <a href={url('/shop')} class="text-xs font-bold uppercase tracking-[.18em] hover:underline">← Volver a la tienda</a>
      <div class="mt-7 grid items-start gap-10 lg:grid-cols-[1.05fr_.95fr] lg:gap-16">
        <div class="overflow-hidden rounded-[1.6rem] bg-[#F8EEE7]">
          <img src={url(`/products/${product.image}.webp`)} alt={`${product.name}, ${product.category} handmade de Michi Pop`} width="900" height="900" class="aspect-square w-full object-cover" />
        </div>
        <div class="max-w-xl pt-4">
          <p class="text-[10px] font-black uppercase tracking-[.22em]">{product.category}</p>
          <h1 class="display-font mt-3 text-6xl font-black tracking-[-.08em] md:text-8xl">{product.name}</h1>
          <p class="mt-5 text-xl font-black">{product.price.toFixed(2).replace('.', ',')} €</p>
          <p class="mt-6 text-base leading-7">{product.description}</p>
          <div class="mt-7">
            <p class="text-[10px] font-black uppercase tracking-[.18em]">Colores</p>
            <div class="mt-3 flex gap-2">
              {product.colors.map((color) => <span class={`h-8 w-8 rounded-full border border-tinta/15 ${colorClass[color]}`} title={color}></span>)}
            </div>
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <span class={`rounded-full border border-tinta px-4 py-2 text-[10px] font-black uppercase tracking-[.14em] ${product.available ? '' : 'opacity-50'}`}>{product.available ? 'Disponible' : 'Agotado'}</span>
            <button disabled class="cursor-not-allowed rounded-full bg-tinta px-6 py-3 text-sm font-bold text-crema opacity-55">Añadir a la cesta</button>
          </div>
          <p class="mt-4 max-w-md text-xs leading-5 text-tinta/65">El prototipo muestra el catálogo y la experiencia visual. El checkout llegará después.</p>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
