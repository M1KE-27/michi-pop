---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import Star from '../components/icons/Star.astro';
import { siteUrl } from '../lib/site';
---

<BaseLayout 
  title="Política de Devoluciones y Reembolsos — Michi Pop" 
  description="Cómo solicitar una devolución o reembolso en Michi Pop, plazos de 14 días y condiciones para productos hechos a mano."
>
  <Nav />

  <main class="min-h-screen px-5 pb-24 pt-32 lg:px-8 lg:pt-36">
    <div class="mx-auto max-w-4xl">
      <!-- Breadcrumb -->
      <a href={siteUrl('/')} class="text-xs font-bold uppercase tracking-[.18em] hover:underline">
        ← Volver al inicio
      </a>

      <!-- Header -->
      <div class="mt-8 text-center sm:text-left">
        <div class="inline-flex items-center gap-2 rounded-full border border-tinta/20 bg-rosa/20 px-3.5 py-1 text-[11px] font-black uppercase tracking-[.2em] text-tinta">
          <Star size={14} /> Garantía de Satisfacción
        </div>
        <h1 class="display-font mt-4 text-4xl font-black tracking-[-0.04em] sm:text-6xl">
          DEVOLUCIONES Y REEMBOLSOS
        </h1>
        <p class="mt-3 text-xs uppercase tracking-widest text-tinta/60">
          Transparencia y tranquilidad en cada pedido
        </p>
      </div>

      <!-- Resumen Proceso -->
      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-linea bg-crema p-5">
          <span class="text-lg">⏱️</span>
          <h3 class="display-font mt-2 text-sm font-black">14 Días Naturales</h3>
          <p class="mt-1 text-xs text-tinta/75">Desde que recibes el paquete en casa.</p>
        </div>
        <div class="rounded-2xl border border-linea bg-[#F8EEE7] p-5">
          <span class="text-lg">✉️</span>
          <h3 class="display-font mt-2 text-sm font-black">Aviso Fácil por Email</h3>
          <p class="mt-1 text-xs text-tinta/75">Escríbenos a iam1ke@proton.me.</p>
        </div>
        <div class="rounded-2xl border border-linea bg-rosa/20 p-5">
          <span class="text-lg">💳</span>
          <h3 class="display-font mt-2 text-sm font-black">Reembolso Seguro</h3>
          <p class="mt-1 text-xs text-tinta/75">En el mismo método de pago original.</p>
        </div>
      </div>

      <!-- Secciones -->
      <div class="mt-8 space-y-6 text-xs leading-6 text-tinta/80 sm:text-sm sm:leading-7">
        <section class="rounded-3xl border border-linea bg-white/40 p-6 sm:p-8">
          <h3 class="display-font text-xl font-extrabold text-tinta">1. Cómo Solicitar una Devolución</h3>
          <ol class="mt-3 list-decimal pl-5 space-y-2">
            <li>Envía un correo electrónico a <a href="mailto:iam1ke@proton.me" class="font-bold underline text-tinta">iam1ke@proton.me</a> o usa nuestro <a href={siteUrl('/contacto')} class="font-bold underline text-tinta">formulario de contacto</a> indicando tu número de pedido y los artículos a devolver.</li>
            <li>Te confirmaremos las instrucciones de embalaje y la dirección de envío del centro de recepción.</li>
            <li>Deposita el paquete debidamente protegido.</li>
            <li>Tras revisar el estado de las piezas devueltas, procesaremos el reembolso íntegro.</li>
          </ol>
        </section>

        <section class="rounded-3xl border border-linea bg-white/40 p-6 sm:p-8">
          <h3 class="display-font text-xl font-extrabold text-tinta">2. Condiciones de los Productos</h3>
          <p class="mt-3">
            Para poder admitir la devolución por desistimiento voluntario, los accesorios y charms deben estar sin usar, en perfecto estado y con sus etiquetas o bolsitas originales de protección.
          </p>
        </section>

        <section class="rounded-3xl border border-linea bg-white/40 p-6 sm:p-8">
          <h3 class="display-font text-xl font-extrabold text-tinta">3. Costes de Devolución</h3>
          <ul class="mt-2 list-disc pl-5 space-y-2">
            <li><strong>Por tara, defecto o daño de transporte:</strong> Michi Pop asume el 100% de los gastos de transporte a través de NACEX para recoger la pieza o enviar el reemplazo.</li>
            <li><strong>Por desistimiento voluntario del cliente:</strong> Los costes directos de envío de la devolución correrán a cargo del comprador conforme al art. 108 del RDL 1/2007.</li>
          </ul>
        </section>

        <section class="rounded-3xl border border-linea bg-white/40 p-6 sm:p-8">
          <h3 class="display-font text-xl font-extrabold text-tinta">4. Excepciones al Derecho de Desistimiento</h3>
          <p class="mt-3">
            Conforme al artículo 103.c del RDL 1/2007, quedan exceptuados del derecho de desistimiento los bienes confeccionados conforme a las especificaciones del consumidor o claramente personalizados (por ejemplo, llaveros o collares con nombres o iniciales personalizados solicitados bajo pedido).
          </p>
        </section>

        <section class="rounded-3xl border border-linea bg-white/40 p-6 sm:p-8">
          <h3 class="display-font text-xl font-extrabold text-tinta">5. Plazos y Métodos de Reembolso</h3>
          <p class="mt-3">
            El reembolso se efectuará a través del mismo medio de pago empleado en la transacción inicial en un plazo máximo de <strong>14 días naturales</strong> a partir de la recepción y comprobación del producto en nuestro taller.
          </p>
        </section>
      </div>

      <div class="mt-10 flex justify-center">
        <a href={siteUrl('/contacto')} class="soft-button rounded-full border border-tinta bg-rosa px-8 py-3 text-sm font-bold text-tinta shadow-[0_5px_0_rgba(244,137,160,.25)]">
          Contactar para una devolución
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
