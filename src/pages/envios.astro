---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import Star from '../components/icons/Star.astro';
import { siteUrl } from '../lib/site';
---

<BaseLayout 
  title="Política de Envíos — Michi Pop" 
  description="Información detallada de envíos rápidos con NACEX desde Valencia (Benicalap), plazos de entrega 24/48h, costes y seguimiento de pedidos."
>
  <Nav />

  <main class="min-h-screen px-5 pb-24 pt-32 lg:px-8 lg:pt-36">
    <div class="mx-auto max-w-4xl">
      <!-- Breadcrumb -->
      <a href={siteUrl('/')} class="text-xs font-bold uppercase tracking-[.18em] hover:underline">
        ← Volver al inicio
      </a>

      <!-- Header -->
      <div class="mt-8 text-center sm:text-left">
        <div class="inline-flex items-center gap-2 rounded-full border border-tinta/20 bg-rosa/20 px-3.5 py-1 text-[11px] font-black uppercase tracking-[.2em] text-tinta">
          <Star size={14} /> Logística y Transporte
        </div>
        <h1 class="display-font mt-4 text-4xl font-black tracking-[-0.04em] sm:text-6xl">
          ENVÍOS Y TRANSPORTE
        </h1>
        <p class="mt-3 text-xs uppercase tracking-widest text-tinta/60">
          Envíos rápidos y cuidados con NACEX Express desde Valencia
        </p>
      </div>

      <!-- Tarjeta destacada NACEX -->
      <div class="mt-10 rounded-3xl border border-linea bg-[#F8EEE7] p-6 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <span class="rounded-full bg-[#EA580C] px-3.5 py-1 text-xs font-black uppercase tracking-wider text-white shadow-sm">
            Agencia Oficial: NACEX
          </span>
          <span class="text-xs font-bold text-tinta/60">Salidas diarias L-V</span>
        </div>
        
        <h2 class="display-font mt-4 text-2xl font-black">Centro de Expedición en Valencia</h2>
        <p class="mt-2 text-xs leading-relaxed text-tinta/75 sm:text-sm">
          Todos los paquetes de Michi Pop salen empaquetados y revisados a mano directamente desde el punto de distribución oficial de NACEX.
        </p>

        <div class="mt-5 grid gap-3 rounded-2xl border border-linea bg-white/80 p-5 text-xs">
          <div class="flex items-start gap-2">
            <span class="font-bold text-tinta">📍 Dirección:</span>
            <span class="text-tinta/90">C/ de la Serra d'Agullent, 23, Benicalap, 46015 València, España</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-bold text-tinta">📞 Teléfono de Logística:</span>
            <a href="tel:960888044" class="font-semibold text-tinta underline hover:text-[#EA580C]">960 88 80 44</a>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-bold text-tinta">⏰ Horario de recogida:</span>
            <span class="text-tinta/90">Lunes a Viernes · Cierre de envíos: 19:00h</span>
          </div>
        </div>
      </div>

      <!-- Secciones detalladas -->
      <div class="mt-8 space-y-6 text-xs leading-6 text-tinta/80 sm:text-sm sm:leading-7">
        <section class="rounded-3xl border border-linea bg-white/40 p-6 sm:p-8">
          <h3 class="display-font text-xl font-extrabold text-tinta">1. Zonas de Envío y Plazos de Entrega</h3>
          <div class="mt-3 space-y-3">
            <div class="rounded-2xl border border-linea bg-crema p-4">
              <span class="font-black uppercase tracking-wider text-tinta">Península Ibérica:</span>
              <p class="mt-1 text-tinta/80"><strong>24 a 48 horas laborables</strong> desde la salida del pedido del taller.</p>
            </div>
            <div class="rounded-2xl border border-linea bg-crema p-4">
              <span class="font-black uppercase tracking-wider text-tinta">Islas Baleares:</span>
              <p class="mt-1 text-tinta/80"><strong>48 a 72 horas laborables</strong>.</p>
            </div>
            <div class="rounded-2xl border border-linea bg-crema p-4">
              <span class="font-black uppercase tracking-wider text-tinta">Canarias, Ceuta y Melilla / Internacional:</span>
              <p class="mt-1 text-tinta/80">[Pendiente de activación en checkout o consultar previamente por soporte].</p>
            </div>
          </div>
        </section>

        <section class="rounded-3xl border border-linea bg-white/40 p-6 sm:p-8">
          <h3 class="display-font text-xl font-extrabold text-tinta">2. Coste del Envío</h3>
          <p class="mt-3">
            Los gastos de envío se calculan de manera transparente en la cesta y en el checkout antes del pago:
          </p>
          <ul class="mt-2 list-disc pl-5 space-y-1.5">
            <li><strong>Envío Estándar NACEX Península:</strong> Tarifa plana fija transparente visible en el checkout.</li>
            <li><strong>Envío Gratuito:</strong> Disponible en promociones especiales o para pedidos que alcancen el importe mínimo promocional indicado en cabecera.</li>
          </ul>
        </section>

        <section class="rounded-3xl border border-linea bg-white/40 p-6 sm:p-8">
          <h3 class="display-font text-xl font-extrabold text-tinta">3. Seguimiento del Envío (Tracking)</h3>
          <p class="mt-3">
            En el momento en que tu paquete sea registrado en el sistema de NACEX, recibirás un correo electrónico y/o SMS con el número de localizador y el enlace directo para seguir el estado de tu entrega en tiempo real hasta tu puerta.
          </p>
        </section>

        <section class="rounded-3xl border border-linea bg-white/40 p-6 sm:p-8">
          <h3 class="display-font text-xl font-extrabold text-tinta">4. Gestión de Incidencias en el Transporte</h3>
          <div class="mt-3 space-y-3">
            <p>
              <strong>¿Qué ocurre si el paquete llega dañado?</strong> Si notas el embalaje exterior deteriorado o el producto golpeado, haz una fotografía y escríbenos a <a href="mailto:iam1ke@proton.me" class="font-bold underline text-tinta">iam1ke@proton.me</a> en un plazo de 48h para gestionar el reemplazo inmediato sin coste.
            </p>
            <p>
              <strong>¿Qué ocurre si el paquete se extravía?</strong> Si la agencia NACEX confirma el extravío de un paquete, Michi Pop te enviará un nuevo pedido de inmediato o te reembolsará el 100% del importe.
            </p>
            <p>
              <strong>¿Qué ocurre si la dirección es incorrecta?</strong> Si detectas un error en la dirección tras hacer el pedido, avísanos con la mayor brevedad antes de las 18:00h del mismo día para corregirlo con la delegación de NACEX en Benicalap.
            </p>
          </div>
        </section>
      </div>

      <div class="mt-10 flex justify-center">
        <a href={siteUrl('/shop')} class="soft-button rounded-full border border-tinta bg-rosa px-8 py-3 text-sm font-bold text-tinta shadow-[0_5px_0_rgba(244,137,160,.25)]">
          Volver a la tienda
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
